*.exe
.vs
/*.dll
*.pdb
/*.lib
build/
out/
bin/imgui.ini
imgui.ini
Microsoft.DTfW.DHL.manifest
.*/
# SPIR-V is compiled from the GLSL sources at run time and cached here; a tracked copy goes stale and the
# cache, trusting its .hash sidecar, serves it.
bin/shaders/vulkan/*.spv
bin/shaders/vulkan/*.spv.hash

# compare-backends.ps1 output: rewritten by every run.
bin/compare/

# BinaryCache: terrain and vegetation built from the scene, rebuilt when missing.
bin/cache/

# compare-rooms output and the perf runs' scratch files: written by the test runs.
bin/compare_rooms/
bin/p*.txt
bin/perf_*.txt

# What the runs write as they go: crash, fatal and repro logs, the hang trace.
bin/*.log
bin/hang.trace
